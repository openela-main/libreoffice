+    
+    struct UnfileObjects {
+        enum Type
+        {
+            Unfile,
+            DeleteSingleFiled,
+            Delete
+        };
+    };
+
+    /** Class representing a CMIS folder.
+      */
+    class Folder : public virtual Object
+    {
+        public:
+            Folder( Session* session ) : Object( session ) { }
+            virtual ~Folder() { }
+
