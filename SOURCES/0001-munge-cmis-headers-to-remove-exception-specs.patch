+        \sa 2.2.2.2 section of the CMIS specifications
+      */
+    class Repository
+    {
+        public:
+
+            enum Capability
+            {
+                ACL,
+                AllVersionsSearchable,
+                Changes,
+                ContentStreamUpdatability,
+                GetDescendants,
+                GetFolderTree,
+                OrderBy,
+                Multifiling,
